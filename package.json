{
  "name": "mtgdb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Binder-page Magic: The Gathering scanner and collection pricer (iPhone web app)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "data": "NODE_USE_ENV_PROXY=1 tsx scripts/build-data.ts",
    "postinstall": "node scripts/copy-vendor.mjs",
    "eval": "NODE_USE_ENV_PROXY=1 tsx scripts/eval-real.ts",
    "baselines": "NODE_USE_ENV_PROXY=1 tsx scripts/build-baselines.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
